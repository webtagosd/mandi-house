---

<Base title="Menu · Mandi House" description="Yemeni mandi, charcoal grills, karahi, biryani and slow broths. The full Mandi House menu, Sandringham, Auckland.">
  <Nav solid />
  <main class="pt-20">
    <!-- header -->
    <header class="px-6 md:px-12 pt-16 md:pt-24 pb-12 md:pb-16">
      <div class="mx-auto max-w-[110rem]">
        <p class="kicker mb-6" data-reveal>[ The Menu ]</p>
        <h1 class="font-display font-light text-cream text-6xl md:text-8xl xl:text-9xl leading-[0.9]" data-reveal>
          Generous by<br /><span class="italic text-saffron">design.</span>
        </h1>
        <p class="body-lg mt-8 max-w-xl" data-reveal>
          Generous portions, bold aromatic spice, and a fire that never hurries.
          Dine in or take away. Ask us about the weekend specials.
        </p>
      </div>
    </header>

    <!-- two-column: left category nav + right menu -->
    <div class="px-6 md:px-12 pb-32">
      <div class="mx-auto max-w-[110rem] grid md:grid-cols-12 gap-10 md:gap-16">
        <!-- LEFT: category nav -->
        <aside class="md:col-span-3">
          <nav id="menu-nav" class="md:sticky md:top-28 flex md:flex-col gap-x-6 gap-y-3 flex-wrap pb-6 md:pb-0 border-b border-brass/15 md:border-0 mb-6 md:mb-0">
            <p class="hidden md:block kicker mb-3">[ Browse ]</p>
            {
              sections.map((s, i) => (
                <a
                  href={`#${s.id}`}
                  data-menu-link={s.id}
                  class="menu-link group flex items-center gap-3 text-sm font-mono uppercase tracking-wider text-cream/45 hover:text-cream transition-colors duration-200 py-1"
                >
                  <span class="hidden md:block w-5 h-px bg-brass/40 transition-all duration-200 group-[.is-active]:w-8 group-[.is-active]:bg-saffron"></span>
                  <span class="tabular-nums opacity-50 text-xs">{String(i + 1).padStart(2, "0")}</span>
                  {s.title}
                </a>
              ))
            }
          </nav>
        </aside>

        <!-- RIGHT: menu sections -->
        <div class="md:col-span-9 flex flex-col gap-20 md:gap-28">
          {
            sections.map((s) => (
              <section id={s.id} class="scroll-mt-28" data-menu-section={s.id}>
                <div class="border-b border-brass/15 pb-5 mb-8" data-reveal>
                  <div class="flex items-baseline justify-between gap-4">
                    <h2 class="font-display font-light text-cream text-4xl md:text-5xl">{s.title}</h2>
                    {s.note && <p class="kicker text-right shrink-0">{s.note}</p>}
                  </div>
                  {s.desc && <p class="text-fog text-sm mt-4 max-w-2xl leading-relaxed">{s.desc}</p>}
                </div>
                <div class="flex flex-col">
                  {s.items.map(([name, desc, price]) => (
                    <div class="flex items-baseline gap-4 py-5 border-b border-brass/10" data-reveal>
                      <div class="flex-1">
                        <h3 class="text-cream text-lg md:text-xl">{name}</h3>
                        {desc && <p class="text-fog text-sm mt-1">{desc}</p>}
                      </div>
                      <span class="font-mono text-saffron text-sm whitespace-nowrap">{price}</span>
                    </div>
                  ))}
                </div>
              </section>
            ))
          }
        </div>
      </div>
    </div>

    <!-- CTA -->
    <section class="bg-coal px-6 md:px-12 py-28 text-center">
      <p class="kicker mb-6" data-reveal>[ Hungry yet? ]</p>
      <h2 class="font-display font-light text-cream text-5xl md:text-7xl mb-10" data-reveal>Come in tonight.</h2>
      <a href="/#visit" class="inline-block text-xs font-mono uppercase tracking-widest px-9 py-4 bg-saffron text-ink rounded-full hover:bg-cream transition-colors duration-300" data-reveal>
        Find us
      </a>
    </section>
  </main>
  <Footer />

  <script>
    // Scrollspy — highlight the category whose section is in view.
    function initMenuSpy() {
      const links = Array.from(
        document.querySelectorAll<HTMLAnchorElement>("[data-menu-link]")
      );
      const sections = Array.from(
        document.querySelectorAll<HTMLElement>("[data-menu-section]")
      );
      if (!links.length || !sections.length) return;

      const byId = new Map(links.map((l) => [l.dataset.menuLink, l]));

      function setActive(id: string | undefined) {
        links.forEach((l) => l.classList.remove("is-active", "text-cream"));
        if (id && byId.has(id)) {
          byId.get(id)!.classList.add("is-active", "text-cream");
        }
      }

      const io = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((e) => e.isIntersecting)
            .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
          if (visible[0]) {
            setActive((visible[0].target as HTMLElement).dataset.menuSection);
          }
        },
        { rootMargin: "-30% 0px -60% 0px", threshold: 0 }
      );
      sections.forEach((s) => io.observe(s));
      setActive(sections[0].dataset.menuSection);
    }
    document.addEventListener("astro:page-load", initMenuSpy);
  </script>
</Base>
