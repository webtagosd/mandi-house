---
// Two-row infinite image marquee — "showcase all the menu items".
import content from "../../content/content.json";
const { gallery } = content;

const PLACEHOLDERS_PER_ROW = 7;

// If a row has no real images yet, fill it with placeholder slots.
const makeRow = (imgs: typeof gallery.row1) =>
  imgs.length ? imgs : Array.from({ length: PLACEHOLDERS_PER_ROW }, () => null);

// Duplicate each row for a seamless -50% loop. The second copy is a visual
// repeat of the same images, not bound (only the first copy carries data-wt,
// so each content.json image is bound exactly once).
const rowOne = makeRow(gallery.row1);
const rowTwo = makeRow(gallery.row2);
const trackOne = [...rowOne, ...rowOne];
const trackTwo = [...rowTwo, ...rowTwo];
---

<section class="relative z-10 bg-coal overflow-hidden py-28 md:py-40">
  <!-- soft saffron wash -->
  <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(ellipse at 50% 0%, rgba(227,165,58,0.10), transparent 55%);"></div>

  <!-- heading -->
  <div class="relative z-10 px-6 md:px-12 text-center max-w-3xl mx-auto mb-16 md:mb-20">
    <p class="kicker mb-6" data-reveal data-wt="gallery.kicker">{gallery.kicker}</p>
    <h2 class="font-display font-light text-cream text-5xl md:text-7xl leading-[0.95]" data-reveal>
      <span data-wt="gallery.headlineLine1">{gallery.headlineLine1}</span> <span class="italic text-saffron" data-wt="gallery.headlineLine2">{gallery.headlineLine2}</span>
    </h2>
    <p class="body-lg mt-7" data-reveal data-wt="gallery.intro">
      {gallery.intro}
    </p>
  </div>

  <!-- two scrolling rows -->
  <div class="gallery-rows relative z-10 flex flex-col gap-5 md:gap-6">
    <div class="scroll-mask">
      <div class="row-track flex gap-5 md:gap-6 w-max">
        {trackOne.map((img, i) => (
          <div class="gallery-tile shrink-0 h-40 md:h-52 lg:h-60 aspect-[4/3] rounded-2xl overflow-hidden border border-brass/15 bg-espresso relative">
            {img ? (
              <img
                src={img.photo}
                data-wt-attr="src"
                data-wt={i < rowOne.length ? `gallery.row1.${i}.photo` : undefined}
                alt="Mandi House dish"
                class="w-full h-full object-cover"
                loading="lazy"
              />
            ) : (
              <span class="absolute inset-0 flex items-center justify-center text-brass/25">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8" aria-hidden="true">
                  <rect x="3" y="3" width="18" height="18" rx="2" />
                  <circle cx="8.5" cy="8.5" r="1.5" />
                  <path d="M21 15l-5-5L5 21" />
                </svg>
              </span>
            )}
          </div>
        ))}
      </div>
    </div>

    <div class="scroll-mask">
      <div class="row-track reverse flex gap-5 md:gap-6 w-max">
        {trackTwo.map((img, i) => (
          <div class="gallery-tile shrink-0 h-40 md:h-52 lg:h-60 aspect-[4/3] rounded-2xl overflow-hidden border border-brass/15 bg-espresso relative">
            {img ? (
              <img
                src={img.photo}
                data-wt-attr="src"
                data-wt={i < rowTwo.length ? `gallery.row2.${i}.photo` : undefined}
                alt="Mandi House dish"
                class="w-full h-full object-cover"
                loading="lazy"
              />
            ) : (
              <span class="absolute inset-0 flex items-center justify-center text-brass/25">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8" aria-hidden="true">
                  <rect x="3" y="3" width="18" height="18" rx="2" />
                  <circle cx="8.5" cy="8.5" r="1.5" />
                  <path d="M21 15l-5-5L5 21" />
                </svg>
              </span>
            )}
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- CTA -->
  <div class="relative z-10 text-center mt-16 md:mt-20 px-6" data-reveal>
    <a
      href="/menu"
      class="group inline-flex items-center gap-2.5 text-xs font-mono uppercase tracking-[0.2em] pl-8 pr-7 py-4 bg-saffron text-ink rounded-full hover:bg-cream transition-colors duration-300"
    >
      <span data-wt="gallery.ctaLabel">{gallery.ctaLabel}</span>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5 transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">
        <path d="M5 12h14M13 6l6 6-6 6" />
      </svg>
    </a>
  </div>
</section>

<style>
  @keyframes mh-marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  .row-track {
    animation: mh-marquee 55s linear infinite;
    will-change: transform;
  }
  .row-track.reverse {
    animation-direction: reverse;
  }

  /* fade the left/right edges so tiles slide in/out cleanly */
  .scroll-mask {
    -webkit-mask: linear-gradient(90deg, transparent 0%, #000 8%, #000 92%, transparent 100%);
    mask: linear-gradient(90deg, transparent 0%, #000 8%, #000 92%, transparent 100%);
  }

  .gallery-tile {
    transition: transform 0.4s var(--ease-sigmoid), filter 0.4s var(--ease-sigmoid);
  }
  .gallery-tile:hover {
    transform: scale(1.04);
    filter: brightness(1.08);
  }

  /* pause the drift while hovering the gallery */
  .gallery-rows:hover .row-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .row-track {
      animation: none;
    }
    .scroll-mask {
      overflow-x: auto;
    }
  }
</style>
