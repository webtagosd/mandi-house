---
import content from "../../content/content.json";
const { business, visit, footer } = content;
const year = new Date().getFullYear();

// The footer uses a tighter "5pm–11pm" hours format (no spaces around the
// en-dash) than the Visit section's "5pm – 11pm" — same source field
// (visit.hours.*), footer-local display convention.
const tighten = (s: string) => s.replace(/ – /g, "–");

// The footer splits the address's suburb/city line onto two lines (its own
// layout, distinct from the Visit section's single "Sandringham, Auckland
// 1025" line) — same business.address.line2 field, split at the comma.
const [addressSuburb, addressCity] = business.address.line2.split(", ");
---

<footer class="relative z-10 bg-coal px-6 md:px-12 pt-24 pb-10 border-t border-brass/15">
  <div class="mx-auto max-w-[110rem]">
    <!-- Wordmark signoff -->
    <p class="kicker mb-6">Sandringham · Auckland</p>
    <h2 class="font-display text-[15vw] md:text-[11vw] leading-[0.85] text-cream/95 -tracking-[0.03em] mb-16">
      <span data-wt="footer.signoff">{footer.signoff.replace(/\.$/, "")}</span><span class="text-saffron">.</span>
    </h2>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-10 border-t border-brass/15 pt-12">
      <div>
        <p class="kicker mb-4">Visit</p>
        <p class="text-cream/80 leading-relaxed text-sm">
          <span data-wt="business.address.line1">{business.address.line1}</span><br /><span data-wt="business.address.line2" set:html={`${addressSuburb}<br />${addressCity}`} />
        </p>
      </div>
      <div>
        <p class="kicker mb-4">Hours</p>
        <p class="text-cream/80 leading-relaxed text-sm">
          Mon–Thu · <span data-wt="visit.hours.weekday">{tighten(visit.hours.weekday)}</span><br />
          Fri · <span data-wt="visit.hours.friday">{tighten(visit.hours.friday)}</span><br />
          Sat–Sun · <span data-wt="visit.hours.weekend">{tighten(visit.hours.weekend)}</span>
        </p>
      </div>
      <div>
        <p class="kicker mb-4">Contact</p>
        <a href="tel:098451144" class="link-underline block text-cream/80 text-sm mb-2">
          <span data-wt="business.phone.display">{business.phone.display}</span>
        </a>
        <a href="/#visit" class="link-underline block text-cream/80 text-sm">Find us</a>
      </div>
      <div>
        <p class="kicker mb-4">More</p>
        <a href="/menu" class="link-underline block text-cream/80 text-sm mb-2">Menu</a>
        <a href="/#story" class="link-underline block text-cream/80 text-sm mb-2">Our Story</a>
        <a href="/#visit" class="link-underline block text-cream/80 text-sm">Find us</a>
      </div>
    </div>

    <div class="mt-16 flex flex-col md:flex-row justify-between gap-4 text-xs text-fog font-mono">
      <span>© {year} <span data-wt="business.name">{business.name}</span>. All rights reserved.</span>
      <a
        href={footer.creditUrl}
        data-wt-attr="href"
        data-wt="footer.creditUrl"
        target="_blank"
        rel="noopener"
        class="link-underline hover:text-cream transition-colors"
      >
        <span data-wt="footer.credit">{footer.credit}</span>
      </a>
    </div>
  </div>
</footer>
