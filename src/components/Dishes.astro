---
// Editorial signature-dish grid. Layout/design attributes (grid span, gradient
// tone, "big" tile flag) are structural, not content, so they stay local here —
// only the dish text/images come from content.json.
import content from "../../content/content.json";
const { dishes } = content;

const LAYOUT = [
  { span: "md:col-span-3 md:row-span-2", tone: "from-[#3a2510] to-[#1a1109]", big: true },
  { span: "md:col-span-3", tone: "from-[#3a1c12] to-[#1a0f09]" },
  { span: "md:col-span-3", tone: "from-[#2c1e0e] to-[#160e07]" },
  { span: "md:col-span-2", tone: "from-[#34240f] to-[#170f08]" },
  { span: "md:col-span-2", tone: "from-[#331a10] to-[#150d08]" },
  { span: "md:col-span-2", tone: "from-[#3d2912] to-[#1a1009]" },
];
const items = dishes.items.map((d, i) => ({ ...d, ...LAYOUT[i] }));
---

<section class="relative z-10 bg-ink px-6 md:px-12 py-28 md:py-40">
  <div class="mx-auto max-w-[110rem]">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-16 md:mb-20">
      <div>
        <p class="kicker mb-5" data-reveal data-wt="dishes.kicker">{dishes.kicker}</p>
        <h2 class="font-display font-light text-cream text-5xl md:text-7xl leading-[0.95]" data-reveal>
          <span data-wt="dishes.headlineLine1">{dishes.headlineLine1}</span><br /><span class="italic text-saffron" data-wt="dishes.headlineLine2">{dishes.headlineLine2}</span>
        </h2>
      </div>
      <a href="/menu" class="link-underline font-mono uppercase tracking-widest text-sm text-cream/80 shrink-0" data-reveal>
        <span data-wt="dishes.linkLabel">{dishes.linkLabel}</span>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-6 gap-4 md:auto-rows-[200px]">
      {
        items.map((d, i) => (
          <article
            class:list={[
              "dish group relative overflow-hidden rounded-2xl border border-brass/15 flex flex-col justify-end p-6 md:p-8 min-h-[200px]",
              d.span,
            ]}
            data-reveal
          >
            {d.image ? (
              <img
                src={d.image}
                data-wt-attr="src"
                data-wt={`dishes.items.${i}.image`}
                alt={d.name}
                loading="lazy"
                class="dish-img absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              />
            ) : (
              <div
                class:list={["dish-img absolute inset-0 bg-gradient-to-br opacity-90 transition-transform duration-700 group-hover:scale-105", d.tone]}
              />
            )}
            <div class="absolute inset-0" style="background:linear-gradient(to top, rgba(14,10,6,0.92), rgba(14,10,6,0.15) 65%);" />
            <div class="relative z-10">
              <span class="font-mono text-xs text-saffron/80 tracking-widest block mb-3" data-wt={`dishes.items.${i}.n`}>{d.n}</span>
              <div class="flex items-baseline justify-between gap-4 mb-2">
                <h3 class:list={["font-display font-light text-cream", d.big ? "text-3xl md:text-5xl" : "text-2xl md:text-3xl"]} data-wt={`dishes.items.${i}.name`}>
                  {d.name}
                </h3>
                <span class="font-mono text-sm text-saffron whitespace-nowrap" data-wt={`dishes.items.${i}.price`}>{d.price}</span>
              </div>
              <p class="text-fog text-sm leading-relaxed max-w-sm" data-wt={`dishes.items.${i}.desc`}>{d.desc}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
