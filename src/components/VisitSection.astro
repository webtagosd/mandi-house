---
// Visit — folded into the single page (anchor #visit).
---

<section id="visit" class="relative z-10 bg-charcoal px-6 md:px-12 py-28 md:py-40 scroll-mt-24">
  <div class="mx-auto max-w-[110rem]">
    <p class="kicker mb-6" data-reveal>[ Visit ]</p>
    <h2 class="font-display font-light text-cream text-5xl md:text-7xl xl:text-8xl leading-[0.95] mb-16" data-reveal>
      Find us on<br /><span class="italic text-saffron">Sandringham Road.</span>
    </h2>

    <div class="grid md:grid-cols-12 gap-12">
      <!-- details -->
      <div class="md:col-span-5 flex flex-col gap-10">
        <div class="border-t border-brass/15 pt-6" data-reveal>
          <p class="kicker mb-3">[ Address ]</p>
          <p class="text-cream text-xl md:text-2xl font-display font-light leading-snug">
            573 Sandringham Road<br />Sandringham, Auckland 1025
          </p>
        </div>

        <div class="border-t border-brass/15 pt-6" data-reveal>
          <p class="kicker mb-4">[ Hours ]</p>
          <ul class="flex flex-col gap-2 text-cream/90">
            <li class="flex justify-between"><span>Monday – Thursday</span><span class="font-mono text-fog">5pm – 11pm</span></li>
            <li class="flex justify-between"><span>Friday</span><span class="font-mono text-fog">5pm – 12am</span></li>
            <li class="flex justify-between"><span>Saturday – Sunday</span><span class="font-mono text-fog">12pm – 12am</span></li>
          </ul>
        </div>

        <div class="border-t border-brass/15 pt-6" data-reveal>
          <p class="kicker mb-3">[ Reservations & takeaway ]</p>
          <a href="tel:098451144" class="font-display font-light text-cream text-3xl md:text-4xl link-underline">09 845 1144</a>
          <p class="text-fog text-sm mt-3">
            Walk-ins welcome. For large platters and the whole lamb leg, please call ahead.
          </p>
        </div>
      </div>

      <!-- location panel — real map, themed to match -->
      <div
        class="md:col-span-7 relative rounded-2xl overflow-hidden border border-brass/15 min-h-[360px] md:min-h-[480px]"
        data-reveal
      >
        <div id="mandi-map" class="absolute inset-0 bg-ink"></div>

        <!-- theme overlays (do not block map drag) -->
        <div class="absolute inset-0 z-[600] pointer-events-none" style="background: radial-gradient(circle at 50% 45%, transparent 45%, rgba(14,10,6,0.55) 100%);"></div>
        <div class="absolute inset-0 z-[600] pointer-events-none" style="box-shadow: inset 0 0 60px rgba(14,10,6,0.7);"></div>

        <!-- open in maps button -->
        <a
          href="https://www.google.com/maps/search/?api=1&query=Mandi+House+573+Sandringham+Road+Auckland"
          target="_blank" rel="noopener"
          class="absolute z-[700] bottom-4 left-4 inline-flex items-center gap-2 font-mono uppercase tracking-widest text-xs text-ink bg-saffron/95 hover:bg-cream pl-4 pr-3.5 py-2.5 rounded-full transition-colors duration-300"
        >
          Open in Google Maps
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </a>
      </div>
    </div>
  </div>
</section>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<style is:global>
  /* warm the dark basemap toward the charcoal + saffron palette */
  #mandi-map .leaflet-tile-pane {
    filter: sepia(0.55) saturate(1.5) hue-rotate(-12deg) brightness(0.82) contrast(1.08);
  }
  #mandi-map .leaflet-container { background: #0e0a06; }
  /* gold pin matching the site marker */
  .mandi-pin { background: transparent; border: 0; }
  .mandi-pin .mp-dot {
    display: block; width: 16px; height: 16px; border-radius: 9999px; background: #e3a53a;
    position: relative;
    box-shadow: 0 0 0 5px rgba(227,165,58,0.22), 0 0 22px 7px rgba(227,165,58,0.55);
  }
  .mandi-pin .mp-dot::after {
    content: ""; position: absolute; inset: 5px; background: #0e0a06; border-radius: 9999px;
  }
  #mandi-map .leaflet-control-attribution {
    background: rgba(14,10,6,0.6); color: #b8ab97; font-size: 9px;
  }
  #mandi-map .leaflet-control-attribution a { color: #c9a44e; }
</style>

<script is:inline>
  (function () {
    var LAT = -36.8923349, LNG = 174.7361633;
    function build() {
      var el = document.getElementById("mandi-map");
      if (!el || !window.L || el._leaflet_id) return;
      var map = L.map(el, {
        zoomControl: false,
        scrollWheelZoom: false,
        attributionControl: true,
        dragging: true,
      }).setView([LAT, LNG], 16);
      L.tileLayer("https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png", {
        maxZoom: 19,
        attribution: '&copy; OpenStreetMap &copy; CARTO',
      }).addTo(map);
      var icon = L.divIcon({
        className: "mandi-pin",
        html: '<span class="mp-dot"></span>',
        iconSize: [16, 16],
        iconAnchor: [8, 8],
      });
      L.marker([LAT, LNG], { icon: icon }).addTo(map);
      setTimeout(function () { map.invalidateSize(); }, 250);
    }
    function ensure() {
      if (window.L) { build(); return; }
      if (document.getElementById("leaflet-js")) {
        document.getElementById("leaflet-js").addEventListener("load", build);
        return;
      }
      var s = document.createElement("script");
      s.id = "leaflet-js";
      s.src = "https://unpkg.com/leaflet@1.9.4/dist/leaflet.js";
      s.onload = build;
      document.head.appendChild(s);
    }
    if (document.readyState !== "loading") ensure();
    else document.addEventListener("DOMContentLoaded", ensure);
    document.addEventListener("astro:page-load", ensure);
  })();
</script>
